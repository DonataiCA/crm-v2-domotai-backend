{
    "name": "express-typescript-template",
    "version": "1.0.0",
    "main": "dist/server.js",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:reset": "npx prisma migrate reset --force --skip-seed",
        "db:migrate": "npx prisma migrate dev",
        "db:deploy": "npx prisma migrate deploy",
        "db:generate": "npx prisma generate",
        "seed:admin": "ts-node prisma/seeders/admin-seed.ts",
        "seed:qa": "ts-node prisma/seeders/qa/index.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1106.0",
        "@prisma/client": "^6.19.3",
        "axios": "^1.19.0",
        "bcryptjs": "^3.0.3",
        "bull": "^4.16.5",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^4.22.2",
        "express-rate-limit": "^8.6.2",
        "google-auth-library": "^11.0.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^4.1.0",
        "multer": "^2.2.0",
        "nodemailer": "^9.0.5",
        "openai": "^7.4.0",
        "pdfkit": "^0.19.1",
        "prisma": "^6.19.3",
        "winston": "^3.19.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^24.13.3",
        "@types/nodemailer": "^8.0.1",
        "@types/pdfkit": "^0.17.6",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "uuid": "^11.1.1"
    }
}
