{
    "name": "express-typescript-template",
    "version": "1.0.0",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "db:reset": "npx prisma migrate reset --force --skip-seed",
        "db:migrate": "npx prisma migrate dev",
        "db:generate": "npx prisma generate",
        "seed:admin": "ts-node prisma/seeders/admin-seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.844.0",
        "@prisma/client": "^6.10.0",
        "@types/multer": "^2.0.0",
        "@types/nodemailer": "^8.0.0",
        "axios": "^1.10.0",
        "bcryptjs": "^3.0.2",
        "bull": "^4.16.5",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.3.2",
        "google-auth-library": "^10.2.0",
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^3.2.0",
        "multer": "^2.0.1",
        "nodemailer": "^8.0.5",
        "openai": "^6.34.0",
        "pdfkit": "^0.18.0",
        "prisma": "^6.10.0",
        "winston": "^3.9.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/pdfkit": "^0.17.5",
        "nodemon": "^3.1.10",
        "ts-node": "^10.9.2",
        "typescript": "^5.2.2"
    }
}
