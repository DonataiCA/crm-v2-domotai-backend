# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://domotai:CHANGE_ME_DB_PASSWORD@localhost:5432/domotaicrm
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://CHANGE_ME_DOMAIN.com

# ── JWT ───────────────────────────────────────────────────────────────────────
# JWT secrets are per-user in DB, no global secret needed

# ── SMTP (SpaceMail) ─────────────────────────────────────────────────────────
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM="Domotai" <notification@domotai.online>

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=CHANGE_ME

# ── AWS S3 (file uploads) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
AWS_S3_BUCKET=CHANGE_ME

# ── Redis (Bull queue) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── OAuth (optional) ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
