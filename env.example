# Valores de ejemplo pensados para desarrollo local con docker-compose.dev.yml
# (Postgres :5450, Redis :6390, Mailpit SMTP :1026 / UI :8026).
#   cp env.example .env

# Database
DATABASE_URL="postgresql://domotai:domotai@localhost:5450/domotaicrm?schema=public"

# Server
PORT=3000
NODE_ENV=development

# CORS: orígenes separados por coma (por defecto :8080 y :5173)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# URL del frontend, usada en los enlaces de los correos
FRONTEND_URL=http://localhost:8080

# SMTP (en local, Mailpit; usuario y contraseña vacíos)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM='"Domotai CRM (dev)" <dev@domotai.local>'

# Recordatorios por correo (barrido en proceso cada REMINDER_INTERVAL_MS)
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MS=300000

# Redis (para Bull)
REDIS_URL=redis://localhost:6390

# AWS S3 (subida de imágenes/adjuntos; sin esto /media/upload falla)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# OpenAI (asistente comercial y generación de tareas desde el PRD; opcional)
OPENAI_API_KEY=

# GitHub (sincronización de repos de proyecto; opcional)
GITHUB_TOKEN=

# Google / Apple sign-in (opcional)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
